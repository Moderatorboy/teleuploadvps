# my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash
# @BotFather token; add this bot to your group
TG_BOT_TOKEN=123456:ABC...
# group chat id (usually starts with -100...)
TG_CHAT_ID=-1001234567890
# private backup channel id (-100...): receives the raw file, no zip/password. Bot must be admin there.
TG_BACKUP_CHAT_ID=-1009876543210
# optional abuse limits per IP (defaults shown)
IP_UPLOADS_PER_HOUR=5
IP_GB_PER_DAY=3
PUBLIC_BASE=https://www.b2gpt.online/teleupload
