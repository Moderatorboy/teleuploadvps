# my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash
# @BotFather token. People must press Start on this bot to receive files.
TG_BOT_TOKEN=123456:ABC...
# private backup channel id (-100...): receives the raw files. Bot must be admin there. Leave empty to disable.
TG_BACKUP_CHAT_ID=-1009876543210
PUBLIC_BASE=https://www.b2gpt.online/teleupload
# optional (defaults shown)
IP_UPLOADS_PER_HOUR=5
IP_GB_PER_DAY=3
LINK_SUFFIX_LEN=4
MIN_FREE_GB=10
